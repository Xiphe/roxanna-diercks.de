{
  "name": "roxanna-diercks.de",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "media:upload": "node content/publishing/upload-media.ts",
    "build:app": "node website/build/assets.ts",
    "build": "npm run content:build && npm run build:app -- --local-media",
    "dev": "wrangler dev content/development/worker.ts --config website/wrangler.jsonc --ip 0.0.0.0 --port 8791 --inspector-port 9232 --live-reload",
    "typecheck": "wrangler types --config website/wrangler.jsonc worker-configuration.d.ts && tsc --noEmit",
    "test": "node --import remix/node-tsx --test website/tests/*.test.ts && playwright test --config website/playwright.config.ts",
    "check": "npm run format:check && npm run typecheck && npm test",
    "deploy": "wrangler deploy --config website/wrangler.jsonc",
    "content:build": "node content/preparation/prepare.ts",
    "content:publish": "cmx-publish .generated/publication.json \"$CMX_PUBLISH_URL\" --config content/publishing/config.ts",
    "typecheck:website": "wrangler types --config website/wrangler.jsonc worker-configuration.d.ts && tsc --noEmit -p website/tsconfig.json",
    "test:website": "npm test",
    "check:website": "prettier website contracts dev.ts tsconfig.json package.json .github/workflows --check && npm run typecheck:website && npm run test:website"
  },
  "dependencies": {
    "@cmx-tools/contracts": "0.3.0",
    "@cmx-tools/document-host": "0.1.1",
    "@cmx-tools/remix": "0.2.0",
    "http-message-sig": "0.3.0",
    "remix": "3.0.0"
  },
  "overrides": {
    "@remix-run/test": {
      "esbuild": "$esbuild"
    }
  },
  "devDependencies": {
    "@cmx-tools/bundle": "0.1.2",
    "@cmx-tools/cli": "0.2.0",
    "@cmx-tools/document": "0.3.0",
    "@cmx-tools/environment": "0.1.2",
    "@cmx-tools/publish": "0.2.0",
    "@playwright/test": "1.64.1",
    "@roxanna/content-components": "file:contracts/components",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
