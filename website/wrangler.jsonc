{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "roxanna-diercks",
  "main": "app/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../dist" },
  "build": {
    "command": "node dev.ts",
    "watch_dir": ["../content", "app", "build", "cmx.config.ts", "../contracts", "../dev.ts"],
  },
  "vars": { "CMX_PUBLISH_PUBLIC_KEYS": "{}" },
  "durable_objects": {
    "bindings": [
      { "name": "CONTENT_STATE", "class_name": "ContentState" },
      { "name": "SIGNUP_LIMITS", "class_name": "SignupLimits" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContentState", "SignupLimits"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "roxanna-diercks-media" }],
  "cache": { "enabled": true },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
}
